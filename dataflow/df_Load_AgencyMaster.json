{
	"name": "df_Load_AgencyMaster",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_ADLS_AgencyMaster",
						"type": "DatasetReference"
					},
					"name": "SourceLakeAgencyMaster"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_SQL_AgencyMaster",
						"type": "DatasetReference"
					},
					"name": "SinkSQLAgencyMaster"
				}
			],
			"transformations": [],
			"scriptLines": [
				"source(output(",
				"          AgencyID as string,",
				"          AgencyName as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> SourceLakeAgencyMaster",
				"SourceLakeAgencyMaster sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          AgencyID as string,",
				"          AgencyName as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     truncate:true,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> SinkSQLAgencyMaster"
			]
		}
	}
}